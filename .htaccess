# ============================================================
# .htaccess — Techmate Root Security Config
# ============================================================

Options -Indexes

<IfModule mod_headers.c>
    # ── Bảo vệ cơ bản ─────────────────────────────────────
    # Chống XSS trên browser cũ
    Header always set X-XSS-Protection "1; mode=block"
    # Chống MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Chặn clickjacking (không cho site bị nhúng vào iframe domain khác)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Kiểm soát thông tin Referer gửi ra ngoài
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Hạn chế browser features không cần thiết
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self 'https://sandbox.vnpayment.vn')"
    # Force HTTPS — HSTS (1 năm, bao gồm subdomain)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # ── Content Security Policy ────────────────────────────
    # Whitelist đã được audit toàn bộ source code (30/04/2026)
    Header always set Content-Security-Policy "default-src 'self'; \
script-src 'self' 'unsafe-inline' 'unsafe-eval' \
    https://code.jquery.com \
    https://cdn.jsdelivr.net \
    https://cdnjs.cloudflare.com \
    https://accounts.google.com \
    https://apis.google.com; \
style-src 'self' 'unsafe-inline' \
    https://cdnjs.cloudflare.com; \
font-src 'self' \
    https://cdnjs.cloudflare.com; \
img-src 'self' data: blob: \
    https://cdn.tgdd.vn \
    https://cdnv2.tgdd.vn \
    https://cdn2.cellphones.com.vn \
    https://dashboard.cellphones.com.vn \
    https://genk.mediacdn.vn \
    https://cdn-icons-png.flaticon.com \
    https://images.dmca.com \
    https://lh3.googleusercontent.com \
    https://img.vietqr.io \
    https://product.hstatic.net \
    https://img-cache.coccoc.com \
    https://cdn.kiotvietweb.vn \
    https://img.vistek.net \
    https://cdn.vjshop.vn \
    https://shinhanfinance.com.vn; \
connect-src 'self' \
    https://accounts.google.com; \
frame-src \
    https://accounts.google.com \
    https://sandbox.vnpayment.vn; \
form-action 'self' \
    https://sandbox.vnpayment.vn; \
frame-ancestors 'self';"
</IfModule>

# ============================================================
# STATIC ASSET CACHE (30 ngày)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Hình ảnh
    ExpiresByType image/jpeg         "access plus 30 days"
    ExpiresByType image/png          "access plus 30 days"
    ExpiresByType image/webp         "access plus 30 days"
    ExpiresByType image/gif          "access plus 30 days"
    ExpiresByType image/svg+xml      "access plus 30 days"
    ExpiresByType image/x-icon       "access plus 30 days"

    # CSS & JS
    ExpiresByType text/css           "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript    "access plus 30 days"

    # Fonts
    ExpiresByType font/woff          "access plus 30 days"
    ExpiresByType font/woff2         "access plus 30 days"
    ExpiresByType application/font-woff  "access plus 30 days"
    ExpiresByType application/font-woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control cho static files
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|css|js|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# ============================================================
# Nén GZIP
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# Chặn truy cập vào các file nhạy cảm
<FilesMatch "\.(env|log|sql|bak|sh|py|rb|htpasswd|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Chặn truy cập trực tiếp vào thư mục config
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^includes/ - [F,L]
</IfModule>
